# ── Supabase ──────────────────────────────────────────────
# Obrigatórios: src/lib/config.ts NÃO tem fallback hardcoded (projeto ainda
# não existe). Sem essas variáveis o app roda só em modo demo.
VITE_SUPABASE_URL=https://SEU_PROJETO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
VITE_SUPABASE_PROJECT_ID=SEU_PROJETO_ID

VITE_APP_VERSION=1.0.0

# ── Observabilidade ───────────────────────────────────────
# Sentry: cole aqui o DSN do projeto (é uma chave pública, pode ir no frontend).
# Sem esta variável o Sentry fica DESLIGADO — o app funciona igual, só não
# reporta erro nenhum. Onde achar: sentry.io > Settings > Projects > [projeto]
# > Client Keys (DSN).
# Na Vercel: Settings > Environment Variables > Add > VITE_SENTRY_DSN (Production).
VITE_SENTRY_DSN=

# Vercel Web Analytics NÃO usa variável de ambiente.
# É ligado em: vercel.com > projeto encorpei-cardio > Analytics > Enable.
# O código já está no app (src/app/providers.tsx) e fica inerte até você ligar lá.
