<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Tema" parent="@android:style/Theme.DeviceDefault.Light.NoActionBar">
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:windowBackground">@color/fundo</item>
        <item name="android:colorAccent">@color/tinta</item>
    </style>
    <style name="BotaoPrimario" parent="@android:style/Widget.DeviceDefault.Button">
        <item name="android:background">@drawable/botao</item>
        <item name="android:textColor">@color/branco</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
    <style name="BotaoContorno" parent="@android:style/Widget.DeviceDefault.Button">
        <item name="android:background">@drawable/botao_contorno</item>
        <item name="android:textColor">@color/tinta</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
</resources>
