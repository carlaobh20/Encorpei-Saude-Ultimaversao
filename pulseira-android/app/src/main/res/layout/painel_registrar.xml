<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fundo"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/sora"
            android:letterSpacing="-0.04"
            android:text="Registrar"
            android:textColor="@color/tinta"
            android:textSize="27sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/reg_plano"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/destaque"
            android:padding="12dp"
            android:textColor="@color/tinta"
            android:textSize="14sp" />

        <Button
            android:id="@+id/reg_bp"
            style="@style/BotaoContorno"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Pressão" />

        <Button
            android:id="@+id/reg_peso"
            style="@style/BotaoContorno"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Peso" />

        <Button
            android:id="@+id/reg_sente"
            style="@style/BotaoContorno"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Como me sinto" />

        <Button
            android:id="@+id/reg_fc"
            style="@style/BotaoContorno"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Batimentos" />

        <Button
            android:id="@+id/reg_spo2"
            style="@style/BotaoContorno"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Oxigenação" />

        <Button
            android:id="@+id/reg_glicose"
            style="@style/BotaoContorno"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Glicemia" />

        <Button
            android:id="@+id/reg_remedios"
            style="@style/BotaoContorno"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Remédios" />

        <Button
            android:id="@+id/reg_sintomas"
            style="@style/BotaoContorno"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Sintoma" />

        <Button
            android:id="@+id/reg_caminhada"
            style="@style/BotaoContorno"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Caminhada" />

        <Button
            android:id="@+id/reg_alimentacao"
            style="@style/BotaoContorno"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Alimentação" />

        <Button
            android:id="@+id/reg_sono"
            style="@style/BotaoContorno"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Sono" />

        <LinearLayout
            android:id="@+id/reg_form"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/cartao"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/reg_ajuda"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/secundaria"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/reg_rotulo_a"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textColor="@color/tinta"
                android:textSize="16sp" />

            <EditText
                android:id="@+id/reg_a"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/campo"
                android:inputType="numberDecimal"
                android:minHeight="56dp"
                android:padding="12dp"
                android:textColor="@color/tinta"
                android:textSize="22sp" />

            <TextView
                android:id="@+id/reg_rotulo_b"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Número menor"
                android:textColor="@color/tinta"
                android:textSize="16sp" />

            <EditText
                android:id="@+id/reg_b"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/campo"
                android:inputType="number"
                android:minHeight="56dp"
                android:padding="12dp"
                android:textColor="@color/tinta"
                android:textSize="22sp" />

            <TextView
                android:id="@+id/reg_rotulo_c"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Batimentos (se o aparelho mostrar)"
                android:textColor="@color/tinta"
                android:textSize="16sp" />

            <EditText
                android:id="@+id/reg_c"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/campo"
                android:hint="70"
                android:inputType="number"
                android:minHeight="56dp"
                android:padding="12dp"
                android:textColor="@color/tinta"
                android:textSize="22sp" />

            <TextView
                android:id="@+id/reg_nota_rotulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="De 0 a 10, como você está hoje?"
                android:textColor="@color/tinta"
                android:textSize="16sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/reg_nota_ajuda"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="0 é o pior dia que você já teve; 10 é o melhor."
                android:textColor="@color/secundaria"
                android:textSize="14sp"
                android:visibility="gone" />

            <EditText
                android:id="@+id/reg_nota"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/campo"
                android:hint="0 a 10"
                android:inputType="number"
                android:minHeight="56dp"
                android:padding="12dp"
                android:textColor="@color/tinta"
                android:textSize="22sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/reg_erro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/aviso"
                android:textSize="14sp" />

            <Button
                android:id="@+id/reg_salvar"
                style="@style/BotaoPrimario"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Salvar" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
