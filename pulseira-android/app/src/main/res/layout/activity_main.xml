<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fundo"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/titulo"
            android:textColor="@color/tinta"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/subtitulo"
            android:textColor="@color/secundaria"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/integracoes"
            android:textColor="@color/bpm"
            android:textSize="15sp" />

        <LinearLayout
            android:id="@+id/login"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@color/cartao"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/entrar_titulo"
                android:textColor="@color/tinta"
                android:textSize="18sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/nome_conta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="@string/nome_completo"
                android:inputType="textPersonName"
                android:minHeight="48dp"
                android:textColor="@color/tinta"
                android:visibility="gone" />

            <EditText
                android:id="@+id/email"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="@string/email"
                android:importantForAutofill="yes"
                android:inputType="textEmailAddress"
                android:minHeight="48dp"
                android:textColor="@color/tinta" />

            <EditText
                android:id="@+id/senha"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/senha"
                android:importantForAutofill="yes"
                android:inputType="textPassword"
                android:minHeight="48dp"
                android:textColor="@color/tinta" />

            <EditText
                android:id="@+id/senha2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/senha_de_novo"
                android:inputType="textPassword"
                android:minHeight="48dp"
                android:textColor="@color/tinta"
                android:visibility="gone" />

            <CheckBox
                android:id="@+id/termos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/aceito_termos"
                android:visibility="gone" />

            <CheckBox
                android:id="@+id/saude"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/aceito_saude"
                android:visibility="gone" />

            <Button
                android:id="@+id/entrar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/entrar" />

            <Button
                android:id="@+id/criar_conta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/criar_conta" />

            <Button
                android:id="@+id/esqueci"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/esqueci" />

            <Button
                android:id="@+id/reenviar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/reenviar"
                android:visibility="gone" />

            <TextView
                android:id="@+id/login_msg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/aviso"
                android:textSize="15sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:id="@+id/link_aviso"
                android:text="@string/cole_o_link"
                android:textColor="@color/secundaria"
                android:textSize="13sp" />
        </LinearLayout>

        <Button
            android:id="@+id/sair"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/sair"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/conteudo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@color/cartao"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/nome"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/nome_generico"
                android:textColor="@color/tinta"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/selo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/selo_nao"
                android:textColor="@color/bpm"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/frase"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/frase_nao"
                android:textColor="@color/secundaria"
                android:textSize="15sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/ultima_titulo"
                android:textAllCaps="true"
                android:textColor="@color/secundaria"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/ultima"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/ultima_vazia"
                android:textColor="@color/tinta"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/chegou_titulo"
                android:textAllCaps="true"
                android:textColor="@color/secundaria"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/chegou"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/chegou_vazio"
                android:textColor="@color/secundaria"
                android:textSize="15sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/unidade"
            android:textColor="@color/tinta"
            android:textSize="16sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/bloco_vivo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@color/cartao"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/bpm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:text="@string/bpm_vazio"
                android:textColor="@color/bpm"
                android:textSize="48sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/contato"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:textColor="@color/secundaria"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/canal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_horizontal"
                android:textColor="@color/secundaria"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_horizontal"
            android:id="@+id/sessao"
            android:text="@string/primeira_medida"
            android:textColor="@color/secundaria"
            android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/mensagem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="@color/aviso"
            android:textSize="15sp" />

        <Button
            android:id="@+id/conectar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:minHeight="48dp"
            android:text="@string/conectar" />

        <Button
            android:id="@+id/desligar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:enabled="false"
            android:minHeight="48dp"
            android:text="@string/desligar" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="@string/importar_titulo"
            android:textColor="@color/tinta"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/importar_sub"
            android:textColor="@color/secundaria"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@color/cartao"
            android:orientation="vertical"
            android:padding="16dp">

            <Button
                android:id="@+id/importar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/importar" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/importar_texto"
                android:textColor="@color/secundaria"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/previa"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/tinta"
                android:textSize="14sp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/mapa"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone" />

            <Button
                android:id="@+id/confirmar_arquivo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/salvar_arquivo"
                android:visibility="gone" />

            <Button
                android:id="@+id/cancelar_arquivo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/cancelar_arquivo"
                android:visibility="gone" />

            <TextView
                android:id="@+id/importar_aviso"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/aviso"
                android:textSize="14sp"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="@string/recursos_titulo"
            android:textColor="@color/tinta"
            android:textSize="18sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@color/cartao"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/recursos_intro"
                android:textColor="@color/secundaria"
                android:textSize="15sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/recursos_lista"
                android:textColor="@color/tinta"
                android:textSize="15sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/recursos_fim"
                android:textColor="@color/secundaria"
                android:textSize="15sp" />
        </LinearLayout>

        <Button
            android:id="@+id/ajuda"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/ajuda_titulo" />

        <TextView
            android:id="@+id/ajuda_corpo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@color/cartao"
            android:padding="16dp"
            android:text="@string/ajuda_texto"
            android:textColor="@color/tinta"
            android:textSize="15sp"
            android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
